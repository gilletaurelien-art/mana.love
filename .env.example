# Copiez ce fichier vers .env.local (jamais versionné) et remplissez les valeurs.

# Clé API Mistral (https://console.mistral.ai/) — LUE CÔTÉ SERVEUR UNIQUEMENT.
# Sans cette clé, la conversation reste en mode démo local.
MISTRAL_API_KEY=

# Modèle Mistral à utiliser (optionnel, défaut : mistral-small-latest).
MISTRAL_MODEL=mistral-small-latest
