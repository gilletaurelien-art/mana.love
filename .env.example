# Copiez ce fichier vers .env.local (jamais versionné) et remplissez les valeurs.

# Clé API Mistral (https://console.mistral.ai/) — LUE CÔTÉ SERVEUR UNIQUEMENT.
# Sans cette clé, la conversation reste en mode démo local.
MISTRAL_API_KEY=

# Modèle Mistral à utiliser (optionnel, défaut : mistral-small-latest).
MISTRAL_MODEL=mistral-small-latest

# Compte (lien magique) — projet Supabase du fondateur, LU CÔTÉ NAVIGATEUR.
# L'ANON KEY est conçue pour être publique : la sécurité tient aux policies
# RLS côté base (supabase/migrations/0001_memoire_declaree.sql), pas au
# secret de cette clé. Préfixe VITE_ obligatoire (Vite n'expose au
# navigateur que les variables ainsi préfixées).
# Sans ces deux valeurs, la page /compte affiche honnêtement "non configuré".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
